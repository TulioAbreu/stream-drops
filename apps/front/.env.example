VITE_TWITCH_CLIENT_ID=your_twitch_client_id
# Usado como fallback; em runtime o OAuth usa window.location.origin/auth.
# Cadastre no Twitch Console: http://localhost:3000/auth E https://seu-dominio.vercel.app/auth
VITE_TWITCH_REDIRECT_URL=http://localhost:3000/auth
# URL pública do app (overlay OBS). Default: https://stream-drops.vercel.app
# VITE_PUBLIC_APP_URL=https://stream-drops.vercel.app
# Set true to use apps/twitch-stub on :4010 (Partner fake + Channel Points)
VITE_TWITCH_STUB=false
# Google OAuth Client ID (Drive/Sheets export). Create at https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
